# Copy to .env and fill in -- this file is committed; .env is not.

# Path to the session data on the host (bind-mounted read-only into the container).
# Must point to the directory that contains <subject>/<session> sub-folders.
HOST_RAW_DIR=/mnt/allen/aind/stage/vr-foraging/data

# Path to the host .aws folder (bind-mounted read-only; no static keys copied).
# Run `aws sso login` (or the equivalent for your auth method) on the host to
# refresh the token; the container picks it up automatically.
HOST_AWS_DIR=/home/svc-vrforaging/.aws

# Profile name in HOST_AWS_DIR/config that the container should use.
AWS_PROFILE=IAmAnywhere

# Subject allowlist -- empty means every subject; comma-separate for multiple.
VRFW_SUBJECTS=

# UID:GID the container runs as. Only needed if `docker compose run --rm
# packaging-watcher --show-config` (or a real scan) shows 0 sessions where you
# expect some -- some NFS exports deny root outright (no EVERYONE@ ACE) and
# require running as an identity their ACLs actually grant access to. Defaults
# to root if left blank. Use a service account, not a personal one, so the
# deployment doesn't depend on any one person's account (`id <account>` on the
# host to look up its UID:GID).
HOST_UID=
HOST_GID=

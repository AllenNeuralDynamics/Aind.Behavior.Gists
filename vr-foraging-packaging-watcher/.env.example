# Host paths and secrets only -- .env is gitignored; everything else lives in
# docker-compose.yml's `environment:` block.

# The share: \\allen\aind\stage\vr-foraging\data. Windows/Docker Desktop can't
# bind-mount a UNC path directly -- use the CIFS volume at the bottom of
# docker-compose.yml instead and leave this unset.
HOST_RAW_DIR=/mnt/vr-foraging-data

# ── AWS credentials ──────────────────────────────────────────────────────────
# The host's .aws folder is mounted read-only into the container so no static
# keys are ever copied.  The IAM role is accessed through a named profile in
# that folder's config file (SSO, credential_process, or role_arn + source).
#
# Linux / macOS default:
HOST_AWS_DIR=/home/svc-vrforaging/.aws
# Windows (Docker Desktop) — use forward slashes or the drive letter form:
#HOST_AWS_DIR=C:/Users/<you>/.aws

# Which profile in config to activate inside the container.
# Must match a [profile <name>] block in HOST_AWS_DIR/config that resolves to
# the IAM role you want the container to use.
AWS_PROFILE=IAmAnywhere

# Only for the CIFS-volume variant.
#SMB_USER=
#SMB_PASSWORD=
#SMB_DOMAIN=allen
